; Engine configuration file.
; Godot 4.4 — Horde Protocol (Arch scaffold)

config_version=5

[application]

config/name="Horde Protocol"
config/description="Portrait survivors-like. Offline Android."
config/version="0.1.0"
run/main_scene="res://scenes/boot/Boot.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.svg"

[autoload]

Events="*res://autoload/Events.gd"
Save="*res://autoload/Save.gd"
Audio="*res://autoload/Audio.gd"
Pool="*res://autoload/Pool.gd"
Game="*res://autoload/Game.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
textures/canvas_textures/default_texture_filter=0
